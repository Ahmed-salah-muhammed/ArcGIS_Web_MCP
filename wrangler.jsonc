/**
 * ArcGIS Web MCP - Cloudflare Workers configuration.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Secrets go in `.dev.vars` (local, gitignored) and `npx wrangler deploy --secrets-file <file>` (deployed):
 *   ARCGIS_CLIENT_ID       client id of YOUR ArcGIS OAuth 2.0 credentials (redirect: <worker>/callback)
 *   COOKIE_ENCRYPTION_KEY  random string, e.g. `openssl rand -hex 32`
 * For the documentation page's contact form (set them BEFORE deploying: deploy refuses while a required one is
 * missing; a fork without a contact form removes both from `secrets.required`, and the form answers "not set up"):
 *   RESEND_API_KEY         an API key of YOUR Resend account (https://resend.com)
 *   CONTACT_TO             the address the messages go to (`npx wrangler secret put CONTACT_TO`)
 * `wrangler dev` loads from .dev.vars ONLY the names listed in `secrets.required`.
 * A fork changes `name` and removes the KV `id` (its first deploy creates a new namespace).
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "arcgis",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-19",
	// global_fetch_strictly_public: outbound fetch only to public hosts; also enables CIMD client metadata documents
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	// The id was written by the first `wrangler deploy` (automatic provisioning); without one, a deploy creates it
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "31ff170c4d504588886a6a3d3015f8b8"
		}
	],
	"vars": {
		// ArcGIS Online by default; an Enterprise portal works too, e.g. "https://gis.example.com/portal"
		"ARCGIS_PORTAL_URL": "https://www.arcgis.com",
		// Comma-separated extra hosts allowed to receive the user's token (e.g. federated servers on another host)
		"ARCGIS_EXTRA_HOSTS": "",
		// Sender of the contact form's emails. Resend's test sender only delivers to your own Resend account's
		// address; to send from your domain, verify it in Resend and use e.g. "ArcGIS Web MCP <contact@your.domain>"
		"CONTACT_FROM": "ArcGIS Web MCP <onboarding@resend.dev>"
	},
	"observability": {
		"enabled": true
	},
	"dev": {
		"port": 8788
	},
	"secrets": {
		"required": [
			"ARCGIS_CLIENT_ID",
			"COOKIE_ENCRYPTION_KEY",
			"RESEND_API_KEY",
			"CONTACT_TO"
		]
	}
}